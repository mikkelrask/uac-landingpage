---
// ReleaseNotes — fetches releases from the GitHub API client-side
// and renders them as HTML. No build-time bake-in needed.
// Replaces the old build-time-only version.
---

<div id="rn-root">
  <div id="rn-loading">
    <p style="color: var(--sl-color-gray-3); font-style: italic;">Loading release notes…</p>
  </div>
  <div id="rn-error" class="rn-error hidden">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
    </svg>
    <span>Could not load release notes from GitHub. <em id="rn-error-msg"></em></span>
  </div>
  <ul id="rn-list" class="rn-list hidden"></ul>
</div>

<script>
(function () {
  const OWNER = "mikkelrask";
  const REPO = "uaclaunchcontrol";

  const root = document.getElementById("rn-root");
  const loading = document.getElementById("rn-loading");
  const errorEl = document.getElementById("rn-error");
  const errorMsg = document.getElementById("rn-error-msg");
  const listEl = document.getElementById("rn-list");

  // ── Helpers ──────────────────────────────────────────

  function slugTag(tag) {
    return "release-" + tag.replace(/[^a-zA-Z0-9-]/g, "-").replace(/-+/g, "-").replace(/^-|-$/g, "");
  }

  function formatDate(iso) {
    const d = new Date(iso);
    return d.toLocaleDateString("en-US", {
      year: "numeric", month: "long", day: "numeric",
    });
  }

  // ── Markdown renderer ────────────────────────────────

  function renderMarkdown(md) {
    if (!md) return "";

    const rawImgs = [];
    let html = md.replace(/<img[^>]*>/gi, (m) => {
      const idx = rawImgs.length;
      rawImgs.push(m);
      return `\x00RAWIMG${idx}\x00`;
    });

    html = html.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

    function inline(text) {
      const imgs = [];
      text = text.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, (_, alt, url) => {
        const idx = imgs.length;
        imgs.push(`<img src="${url}" alt="${alt}" loading="lazy" />`);
        return `\x00IMG${idx}\x00`;
      });
      text = text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');
      text = text.replace(/(https?:\/\/[^\s<"'\x00]+)/g, '<a href="$1" target="_blank" rel="noopener noreferrer">$1</a>');
      text = text.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
      text = text.replace(/\*([^*]+)\*/g, "<em>$1</em>");
      text = text.replace(/_([^_]+)_/g, "<em>$1</em>");
      text = text.replace(/~~([^~]+)~~/g, "<del>$1</del>");
      text = text.replace(/`([^`]+)`/g, "<code>$1</code>");
      text = text.replace(/\x00IMG(\d+)\x00/g, (_, d) => imgs[parseInt(d)]);
      return text;
    }

    const lines = html.split("\n");
    const out = [];
    let listTag = "";
    let inCodeBlock = false;

    function closeList() {
      if (listTag) {
        out.push(listTag === "task" ? "</ul>" : `</${listTag}>`);
        listTag = "";
      }
    }

    for (let i = 0; i < lines.length; i++) {
      let line = lines[i];
      if (/^```/.test(line)) {
        closeList();
        if (inCodeBlock) { out.push("</code></pre>"); inCodeBlock = false; }
        else { out.push("<pre><code>"); inCodeBlock = true; }
        continue;
      }
      if (inCodeBlock) { out.push(line + "\n"); continue; }
      line = inline(line);
      if (/^\s*$/.test(line)) { closeList(); out.push(""); continue; }
      const hMatch = line.match(/^(#{1,4})\s+(.+)/);
      if (hMatch) {
        closeList();
        const level = Math.min(hMatch[1].length + 1, 6);
        out.push(`<h${level}>${hMatch[2]}</h${level}>`);
        continue;
      }
      if (/^---+$/.test(line)) { closeList(); out.push("<hr />"); continue; }
      const taskMatch = line.match(/^[-*]\s+\[([ xX])\]\s+(.+)/);
      if (taskMatch) {
        const checked = taskMatch[1] !== " ";
        if (listTag !== "task") { closeList(); listTag = "task"; out.push('<ul class="contains-task-list">'); }
        out.push(`<li class="task-list-item${checked ? " checked" : ""}"><input type="checkbox"${checked ? " checked" : ""} disabled />${taskMatch[2]}</li>`);
        continue;
      }
      const ulMatch = line.match(/^[-*]\s+(.+)/);
      if (ulMatch) {
        if (listTag !== "ul") { closeList(); listTag = "ul"; out.push("<ul>"); }
        out.push(`<li>${ulMatch[1]}</li>`);
        continue;
      }
      const olMatch = line.match(/^\d+\.\s+(.+)/);
      if (olMatch) {
        if (listTag !== "ol") { closeList(); listTag = "ol"; out.push("<ol>"); }
        out.push(`<li>${olMatch[1]}</li>`);
        continue;
      }
      closeList();
      out.push(line);
    }
    closeList();
    if (inCodeBlock) out.push("</code></pre>");
    let result = out.join("\n");
    result = result.replace(/\x00RAWIMG(\d+)\x00/g, (_, d) => rawImgs[parseInt(d)]);
    const blocks = result.split(/\n{2,}/).filter((b) => b.trim());
    const wrapped = blocks.map((block) => {
      const trimmed = block.trim();
      if (/^<(ul|ol|h[1-6]|hr|pre|li)/i.test(trimmed) || /^<\/(ul|ol)/i.test(trimmed)) return trimmed;
      if (/^<p>/i.test(trimmed)) return trimmed;
      return `<p>${trimmed}</p>`;
    });
    result = wrapped.join("\n");
    result = result.replace(/<li><p>/g, "<li>");
    result = result.replace(/<\/p><\/li>/g, "</li>");
    result = result.replace(/<br \/>\s*<br \/>/g, "<br />");
    return result;
  }

  // ── Fetch + render ───────────────────────────────────

  async function load() {
    try {
      const allReleases = [];
      for (let page = 1; page <= 5; page++) {
        const url = `https://api.github.com/repos/${OWNER}/${REPO}/releases?per_page=20&page=${page}`;
        const res = await fetch(url, { headers: { Accept: "application/vnd.github.v3+json" } });
        if (!res.ok) throw new Error(`GitHub API returned ${res.status}`);
        const data = await res.json();
        if (!Array.isArray(data) || data.length === 0) break;
        allReleases.push(...data);
        if (data.length < 20) break;
      }
      releaseNotes(allReleases);
    } catch (e) {
      loading.classList.add("hidden");
      errorMsg.textContent = e.message;
      errorEl.classList.remove("hidden");
    }
  }

  function releaseNotes(releases) {
    loading.classList.add("hidden");

    if (releases.length === 0) {
      listEl.innerHTML = '<p style="color: var(--sl-color-gray-3)">No releases found.</p>';
      listEl.classList.remove("hidden");
      return;
    }

    let html = "";
    for (let i = 0; i < releases.length; i++) {
      const r = releases[i];
      const slug = slugTag(r.tag_name);
      const isLatest = i === 0;
      html += `<li class="rn-release${isLatest ? " rn-release--latest" : ""}">`;
      if (isLatest || r.prerelease) {
        html += `<span class="rn-badge${r.prerelease ? " rn-badge--pre" : ""}">${r.prerelease ? "Pre-release" : "Latest"}</span>`;
      }
      html += `<div class="rn-tag-row"><a href="${r.html_url}" target="_blank" rel="noopener noreferrer" class="rn-tag">${escapeHtml(r.tag_name)}</a>`;
      html += `<span class="rn-date">${formatDate(r.published_at)}</span></div>`;
      html += `<h2 id="${slug}" class="rn-title">${escapeHtml(r.name || r.tag_name)}</h2>`;
      html += `<div class="rn-body">${renderMarkdown(r.body)}</div></li>`;
    }
    listEl.innerHTML = html;
    listEl.classList.remove("hidden");

    // Inject TOC entries
    const toc = document.querySelector("starlight-toc");
    const tocList = toc?.querySelector(":scope > nav > ul");
    if (tocList) {
      document.querySelectorAll("#rn-list .rn-title[id]").forEach((h) => {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = "#" + h.id;
        const span = document.createElement("span");
        span.textContent = h.textContent;
        a.appendChild(span);
        li.appendChild(a);
        tocList.appendChild(li);
      });
    }
  }

  function escapeHtml(str) {
    const d = document.createElement("div");
    d.textContent = str;
    return d.innerHTML;
  }

  load();
})();
</script>

<style>
  /* ── loading ────────────────────────────────────── */
  .hidden { display: none; }

  /* ── error ──────────────────────────────────────── */
  .rn-error {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.25rem;
    border: 1px solid hsl(0 84% 40% / 0.4);
    background: hsl(0 84% 60% / 0.06);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
  .rn-error svg { flex-shrink: 0; color: hsl(0 84% 60%); }

  /* ── release list ──────────────────────────────── */
  .rn-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .rn-release {
    background: var(--sl-color-bg-card);
    border: 1px solid var(--sl-color-hairline);
    padding: 1.75rem 2rem;
    position: relative;
    transition: border-color 200ms;
  }
  .rn-release:hover { border-color: var(--sl-color-gray-4); }
  .rn-release--latest { border-color: hsl(0 84% 60% / 0.35); }
  .rn-release--latest::before {
    content: "";
    position: absolute;
    inset: -1px;
    border: 1px solid hsl(0 84% 60% / 0.2);
    pointer-events: none;
  }

  .rn-badge {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.2em 0.6em;
    margin-bottom: 0.75rem;
    background: hsl(0 84% 60% / 0.12);
    color: hsl(0 84% 60%);
    border: 1px solid hsl(0 84% 60% / 0.25);
  }
  .rn-badge--pre {
    background: hsl(40 100% 50% / 0.1);
    color: hsl(40 100% 55%);
    border-color: hsl(40 100% 50% / 0.25);
  }

  .rn-tag-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.4rem;
    flex-wrap: wrap;
  }
  .rn-tag {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-lg);
    font-weight: 600;
    color: hsl(0 84% 60%);
    text-decoration: none;
    transition: color 150ms;
  }
  .rn-tag:hover {
    color: hsl(0 80% 70%);
    text-decoration: underline;
  }
  .rn-date {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
  }

  .rn-title {
    font-family: "Aldrich", sans-serif;
    font-size: var(--sl-text-h5);
    color: var(--sl-color-white);
    margin: 0 0 1rem 0;
    letter-spacing: 0.02em;
  }

  .rn-body {
    font-size: var(--sl-text-sm);
    line-height: 1.7;
    color: var(--sl-color-gray-2);
    overflow-wrap: break-word;
  }
  .rn-body p { margin: 0 0 0.75rem 0; }
  .rn-body p:last-child { margin-bottom: 0; }
  .rn-body h3, .rn-body h4 {
    font-family: "Aldrich", sans-serif;
    color: var(--sl-color-white);
    margin: 1.25rem 0 0.5rem 0;
    font-size: var(--sl-text-h5);
    border: none;
    padding: 0;
  }
  .rn-body ul { margin: 0.5rem 0; padding-left: 1.5rem; }
  .rn-body li { margin-bottom: 0.25rem; }
  .rn-body code {
    background: var(--sl-color-bg-inline-code);
    color: hsl(0 80% 70%);
    padding: 0.1em 0.4em;
    font-size: 0.9em;
    border-radius: 2px;
  }
  .rn-body img {
    max-width: 100%;
    height: auto;
    margin: 1rem 0;
    border: 1px solid var(--sl-color-hairline);
    box-shadow: var(--sl-shadow-md);
  }
  .rn-body a { color: hsl(0 84% 60%); text-decoration: underline; transition: color 150ms; }
  .rn-body a:hover { color: hsl(0 80% 70%); }
  .rn-body hr { border: none; border-top: 1px solid var(--sl-color-hairline); margin: 1.5rem 0; }
  .rn-body blockquote {
    border-left: 3px solid hsl(0 84% 60% / 0.5);
    background: hsl(0 84% 60% / 0.04);
    padding: 0.5rem 1rem;
    margin: 0.75rem 0;
    color: var(--sl-color-gray-3);
  }
  .rn-body strong { color: var(--sl-color-white); }
</style>
