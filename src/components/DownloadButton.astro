---
// Smart OS-aware download button for UAC Launch Control
// Fetches the latest release from GitHub and auto-selects the right asset for the user's OS.
// Accepts `compact` prop to render as an inline hero-action-sized button.

export interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

{
  compact ? (
    <span class="download-compact-wrap">
      <a
        id="download-main"
        class="download-compact"
        href="https://github.com/mikkelrask/uaclaunchcontrol/releases/latest"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span id="os-label" class="dc-label">Download</span>
        <span id="os-svg" class="dc-os-svg"></span>
      </a>
      <button id="dropdown-toggle" class="dc-toggle" aria-label="Other platforms" type="button">
        <svg viewBox="0 0 12 12" fill="none">
          <path d="M2 4.5L6 8.5L10 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div id="dropdown-menu" class="compact-dropdown hidden">
        <button data-os="windows" class="c-option" type="button">
          <span class="c-option-icon">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><rect x="1" y="1" width="6" height="6" rx="1" fill="currentColor" opacity="0.7"/><rect x="9" y="1" width="6" height="6" rx="1" fill="currentColor" opacity="0.7"/><rect x="1" y="9" width="6" height="6" rx="1" fill="currentColor" opacity="0.7"/><rect x="9" y="9" width="6" height="6" rx="1" fill="currentColor" opacity="0.7"/></svg>
          </span>
          <span class="c-option-text">.exe (<strong>Windows</strong>)</span>
          <span class="c-option-size" id="size-windows"></span>
        </button>
        <button data-os="macos" class="c-option" type="button">
          <span class="c-option-icon">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M11.4 0C11.5 1.3 11 2.5 10.3 3.3C9.6 4.1 8.5 4.6 7.3 4.5C7.2 3.2 7.7 2 8.4 1.2C9.2 0.4 10.4 0 11.4 0Z" fill="currentColor"/><path d="M14.5 5.5C13.4 4.5 11.9 4.2 10.5 4.7C9.8 4.9 9.2 5.3 8.5 5.3C7.8 5.3 7.1 4.9 6.3 4.7C4.9 4.2 3.2 4.6 2 5.7C0.5 7.1 0.2 10.1 1.5 12.5C2.2 13.7 3 14.9 4 15.5C4.7 15.9 5.2 15.8 5.8 15.6C6.4 15.4 6.9 15.2 7.6 15.2C8.3 15.2 8.7 15.4 9.3 15.6C10 15.8 10.5 15.9 11.2 15.5C12.3 14.9 13.1 13.6 13.8 12.4C14.6 11 14.9 10 15 9.7C14.8 9.6 13.1 8.9 13 7.2C12.9 5.8 13.8 5.1 14.5 5.5Z" fill="currentColor"/></svg>
          </span>
          <span class="c-option-text">.dmg (<strong>macOS</strong>)</span>
          <span class="c-option-size" id="size-macos"></span>
        </button>
        <button data-os="linux" class="c-option" type="button">
          <span class="c-option-icon">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M8 0C5.8 0 4 1.8 4 4C4 5.1 4.4 6.1 5.1 6.9C4.3 7.4 3.7 8.2 3.5 9.2C3.2 10.8 3.8 12.4 5 13.4C5.7 14 6.6 14.3 7.5 14.3H8.5C9.4 14.3 10.3 14 11 13.4C12.2 12.4 12.8 10.8 12.5 9.2C12.3 8.2 11.7 7.4 10.9 6.9C11.6 6.1 12 5.1 12 4C12 1.8 10.2 0 8 0Z" fill="currentColor" opacity="0.7"/><path d="M6 11C6 11.6 5.6 12 5 12C4.4 12 4 11.6 4 11C4 10.4 4.4 10 5 10C5.6 10 6 10.4 6 11Z" fill="currentColor"/><path d="M12 11C12 11.6 11.6 12 11 12C10.4 12 10 11.6 10 11C10 10.4 10.4 10 11 10C11.6 10 12 10.4 12 11Z" fill="currentColor"/></svg>
          </span>
          <span class="c-option-text">.AppImage (<strong>Linux</strong>)</span>
          <span class="c-option-size" id="size-linux"></span>
        </button>
      </div>
    </span>
  ) : (
    <div class="download-container">
      <div class="download-btn-group">
        <a
          id="download-main"
          class="download-main"
          href="https://github.com/mikkelrask/uaclaunchcontrol/releases/latest"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="download-main-icon">⌄</span>
          <span class="download-main-text">
            <span id="os-label" class="download-main-label">Download Latest Release</span>
            <span id="version-tag" class="version-tag"></span>
          </span>
        </a>
        <button id="dropdown-toggle" class="dropdown-toggle" aria-label="Other platforms" type="button">
          <svg width="12" height="8" viewBox="0 0 12 8" fill="none">
            <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
      <div id="dropdown-menu" class="dropdown-menu hidden">
        <button data-os="windows" class="platform-option" type="button">
          <span class="platform-icon">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="1" width="6" height="6" rx="1" fill="currentColor" opacity="0.7"/><rect x="9" y="1" width="6" height="6" rx="1" fill="currentColor" opacity="0.7"/><rect x="1" y="9" width="6" height="6" rx="1" fill="currentColor" opacity="0.7"/><rect x="9" y="9" width="6" height="6" rx="1" fill="currentColor" opacity="0.7"/></svg>
          </span>
          <span class="platform-text">Download for <strong>Windows</strong></span>
          <span class="platform-size" id="size-windows"></span>
        </button>
        <button data-os="macos" class="platform-option" type="button">
          <span class="platform-icon">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M11.4 0C11.5 1.3 11 2.5 10.3 3.3C9.6 4.1 8.5 4.6 7.3 4.5C7.2 3.2 7.7 2 8.4 1.2C9.2 0.4 10.4 0 11.4 0Z" fill="currentColor"/><path d="M14.5 5.5C13.4 4.5 11.9 4.2 10.5 4.7C9.8 4.9 9.2 5.3 8.5 5.3C7.8 5.3 7.1 4.9 6.3 4.7C4.9 4.2 3.2 4.6 2 5.7C0.5 7.1 0.2 10.1 1.5 12.5C2.2 13.7 3 14.9 4 15.5C4.7 15.9 5.2 15.8 5.8 15.6C6.4 15.4 6.9 15.2 7.6 15.2C8.3 15.2 8.7 15.4 9.3 15.6C10 15.8 10.5 15.9 11.2 15.5C12.3 14.9 13.1 13.6 13.8 12.4C14.6 11 14.9 10 15 9.7C14.8 9.6 13.1 8.9 13 7.2C12.9 5.8 13.8 5.1 14.5 5.5Z" fill="currentColor"/></svg>
          </span>
          <span class="platform-text">Download for <strong>macOS</strong></span>
          <span class="platform-size" id="size-macos"></span>
        </button>
        <button data-os="linux" class="platform-option" type="button">
          <span class="platform-icon">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 0C5.8 0 4 1.8 4 4C4 5.1 4.4 6.1 5.1 6.9C4.3 7.4 3.7 8.2 3.5 9.2C3.2 10.8 3.8 12.4 5 13.4C5.7 14 6.6 14.3 7.5 14.3H8.5C9.4 14.3 10.3 14 11 13.4C12.2 12.4 12.8 10.8 12.5 9.2C12.3 8.2 11.7 7.4 10.9 6.9C11.6 6.1 12 5.1 12 4C12 1.8 10.2 0 8 0Z" fill="currentColor" opacity="0.7"/><path d="M6 11C6 11.6 5.6 12 5 12C4.4 12 4 11.6 4 11C4 10.4 4.4 10 5 10C5.6 10 6 10.4 6 11Z" fill="currentColor"/><path d="M12 11C12 11.6 11.6 12 11 12C10.4 12 10 11.6 10 11C10 10.4 10.4 10 11 10C11.6 10 12 10.4 12 11Z" fill="currentColor"/></svg>
          </span>
          <span class="platform-text">Download for <strong>Linux</strong></span>
          <span class="platform-size" id="size-linux"></span>
        </button>
      </div>
    </div>
  )
}

<script>
(function () {
  const API_URL =
    "https://api.github.com/repos/mikkelrask/uaclaunchcontrol/releases/latest";
  const FALLBACK_URL =
    "https://github.com/mikkelrask/uaclaunchcontrol/releases/latest";

  // Asset matchers
  const MATCHERS = {
    windows: (name) => /^uac-launch-control-.+-setup\.exe$/i.test(name),
    macos: (name) => /^uac-launch-control-.+-mac-arm64\.dmg$/i.test(name),
    linux: (name) => /^uac-launch-control-.+-linux-x86_64\.AppImage$/i.test(name),
  };

  function detectOS() {
    const ua = navigator.userAgent;
    if (/Windows/i.test(ua)) return "windows";
    if (/Mac/i.test(ua) && !/iPhone|iPad|iPod/i.test(ua)) return "macos";
    if (/Linux/i.test(ua) && !/Android/i.test(ua)) return "linux";
    return "windows";
  }

  // --- OS SVG icons for the button ---
  const OS_SVGS = {
    windows: '<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="1" width="6" height="6" rx="1" fill="currentColor" opacity="0.7"/><rect x="9" y="1" width="6" height="6" rx="1" fill="currentColor" opacity="0.7"/><rect x="1" y="9" width="6" height="6" rx="1" fill="currentColor" opacity="0.7"/><rect x="9" y="9" width="6" height="6" rx="1" fill="currentColor" opacity="0.7"/></svg>',
    macos: '<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M11.4 0C11.5 1.3 11 2.5 10.3 3.3C9.6 4.1 8.5 4.6 7.3 4.5C7.2 3.2 7.7 2 8.4 1.2C9.2 0.4 10.4 0 11.4 0Z" fill="currentColor"/><path d="M14.5 5.5C13.4 4.5 11.9 4.2 10.5 4.7C9.8 4.9 9.2 5.3 8.5 5.3C7.8 5.3 7.1 4.9 6.3 4.7C4.9 4.2 3.2 4.6 2 5.7C0.5 7.1 0.2 10.1 1.5 12.5C2.2 13.7 3 14.9 4 15.5C4.7 15.9 5.2 15.8 5.8 15.6C6.4 15.4 6.9 15.2 7.6 15.2C8.3 15.2 8.7 15.4 9.3 15.6C10 15.8 10.5 15.9 11.2 15.5C12.3 14.9 13.1 13.6 13.8 12.4C14.6 11 14.9 10 15 9.7C14.8 9.6 13.1 8.9 13 7.2C12.9 5.8 13.8 5.1 14.5 5.5Z" fill="currentColor"/></svg>',
    linux: '<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 0C5.8 0 4 1.8 4 4C4 5.1 4.4 6.1 5.1 6.9C4.3 7.4 3.7 8.2 3.5 9.2C3.2 10.8 3.8 12.4 5 13.4C5.7 14 6.6 14.3 7.5 14.3H8.5C9.4 14.3 10.3 14 11 13.4C12.2 12.4 12.8 10.8 12.5 9.2C12.3 8.2 11.7 7.4 10.9 6.9C11.6 6.1 12 5.1 12 4C12 1.8 10.2 0 8 0Z" fill="currentColor" opacity="0.7"/><path d="M6 11C6 11.6 5.6 12 5 12C4.4 12 4 11.6 4 11C4 10.4 4.4 10 5 10C5.6 10 6 10.4 6 11Z" fill="currentColor"/><path d="M12 11C12 11.6 11.6 12 11 12C10.4 12 10 11.6 10 11C10 10.4 10.4 10 11 10C11.6 10 12 10.4 12 11Z" fill="currentColor"/></svg>',
  };

  // --- DOM refs ---
  const downloadMain = document.getElementById("download-main");
  const osLabel = document.getElementById("os-label");
  const osSvg = document.getElementById("os-svg");
  const versionTag = document.getElementById("version-tag");
  const toggleBtn = document.getElementById("dropdown-toggle");
  const dropdown = document.getElementById("dropdown-menu");
  const options = dropdown.querySelectorAll(".platform-option, .c-option");
  const sizeEls = {
    windows: document.getElementById("size-windows"),
    macos: document.getElementById("size-macos"),
    linux: document.getElementById("size-linux"),
  };

  // --- State ---
  let assets = {};

  function setOSSvg(os) {
    if (osSvg && OS_SVGS[os]) {
      osSvg.innerHTML = OS_SVGS[os];
    }
  }

  function formatSize(bytes) {
    if (!bytes) return "";
    const mb = bytes / (1024 * 1024);
    if (mb >= 1000) return `${(mb / 1024).toFixed(1)} GB`;
    return `${Math.round(mb)} MB`;
  }

  function updateMainButton(os) {
    const asset = assets[os];
    if (asset) {
      downloadMain.href = asset.browser_download_url;
      downloadMain.download = asset.name;
    } else {
      downloadMain.href = FALLBACK_URL;
    }
    const names = {
      windows: "Windows",
      macos: "macOS",
      linux: "Linux",
    };
    osLabel.textContent = `Download`;
    setOSSvg(os);
  }

  function updateVersion(tag) {
    if (versionTag) {
      const v = tag || "";
      versionTag.textContent = v ? (v.startsWith("v") ? v : `v${v}`) : "";
    }
  }

  function closeDropdown() {
    dropdown.classList.add("hidden");
    if (toggleBtn) toggleBtn.classList.remove("active");
  }

  function toggleDropdown(e) {
    e.stopPropagation();
    const isOpen = !dropdown.classList.contains("hidden");
    if (isOpen) {
      closeDropdown();
    } else {
      dropdown.classList.remove("hidden");
      if (toggleBtn) toggleBtn.classList.add("active");
    }
  }

  // --- Event listeners ---
  if (toggleBtn) {
    toggleBtn.addEventListener("click", toggleDropdown);
  }

  options.forEach((btn) => {
    btn.addEventListener("click", function () {
      const os = this.dataset.os;
      updateMainButton(os);
      closeDropdown();
      options.forEach((o) => o.classList.remove("selected"));
      this.classList.add("selected");
    });
  });

  document.addEventListener("click", function (e) {
    const container = document.querySelector(".download-container, .download-compact-wrap");
    if (container && !container.contains(e.target)) {
      closeDropdown();
    }
  });

  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") closeDropdown();
  });

  // --- Fetch latest release ---
  const detectedOS = detectOS();

  fetch(API_URL)
    .then((res) => {
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return res.json();
    })
    .then((data) => {
      const tag = data.tag_name || "";
      updateVersion(tag);

      data.assets.forEach((asset) => {
        for (const [os, matcher] of Object.entries(MATCHERS)) {
          if (matcher(asset.name)) {
            assets[os] = asset;
            if (sizeEls[os]) {
              sizeEls[os].textContent = formatSize(asset.size);
            }
            break;
          }
        }
      });

      const primaryOS = assets[detectedOS] ? detectedOS : Object.keys(assets)[0] || "windows";
      updateMainButton(primaryOS);

      options.forEach((o) => {
        o.classList.toggle("selected", o.dataset.os === primaryOS);
      });
    })
    .catch(() => {
      osLabel.textContent = "Download Latest Release";
      downloadMain.href = FALLBACK_URL;
    });
})();
</script>

<style>
  /* ── Full (non-compact) styles ─────────────────────── */
  .download-container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
    width: 100%;
    max-width: 420px;
  }

  .download-btn-group {
    display: flex;
    width: 100%;
    position: relative;
    z-index: 2;
  }

  .download-main {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.5rem;
    background: hsl(0 84% 40%);
    border: 1px solid hsl(0 84% 40%);
    color: hsl(0 0% 100%) !important;
    font-family: "Aldrich", sans-serif;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none !important;
    cursor: pointer;
    transition: background 150ms, border-color 150ms;
    user-select: none;
    white-space: nowrap;
  }

  .download-main:hover {
    background: hsl(0 80% 50%);
    border-color: hsl(0 80% 50%);
  }

  .download-main-icon {
    font-size: 1.3rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .download-main-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1rem;
    line-height: 1.2;
    min-width: 0;
  }

  .download-main-label {
    font-size: 0.95rem;
  }

  .version-tag {
    font-size: 0.65rem;
    opacity: 0.7;
    font-weight: 400;
    letter-spacing: 0.05em;
    font-family: inherit;
  }

  .dropdown-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    flex-shrink: 0;
    background: hsl(0 84% 35%);
    border: 1px solid hsl(0 84% 40%);
    border-left: 1px solid hsla(0, 0%, 100%, 0.15);
    color: hsl(0 0% 100%);
    cursor: pointer;
    transition: background 150ms;
    padding: 0;
  }

  .dropdown-toggle:hover,
  .dropdown-toggle.active {
    background: hsl(0 80% 45%);
  }

  .dropdown-toggle svg {
    transition: transform 200ms;
  }

  .dropdown-toggle.active svg {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 100;
    margin-top: 2px;
    min-width: 100%;
    width: max-content;
    background: hsl(220 18% 8%);
    border: 1px solid hsl(220 12% 18%);
    box-shadow: 0 8px 24px hsla(0, 0%, 0%, 0.5);
  }

  .dropdown-menu.hidden {
    display: none;
  }

  .platform-option {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    padding: 0.85rem 1.25rem;
    background: transparent;
    border: none;
    color: hsl(215 12% 70%);
    font-family: "Aldrich", sans-serif;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: background 150ms, color 150ms;
    text-align: left;
    border-bottom: 1px solid hsl(220 12% 14%);
  }

  .platform-option:last-child {
    border-bottom: none;
  }

  .platform-option:hover {
    background: hsl(220 12% 16%);
    color: hsl(210 20% 92%);
  }

  .platform-option.selected {
    color: hsl(0 84% 60%);
    background: hsl(0 84% 60% / 0.08);
  }

  .platform-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    opacity: 0.8;
  }

  .platform-text {
    flex: 1;
  }

  .platform-text strong {
    color: inherit;
    font-weight: 400;
  }

  .platform-size {
    font-size: 0.68rem;
    opacity: 0.45;
    flex-shrink: 0;
    font-family: "Courier New", Courier, monospace;
    text-transform: none;
  }

  /* ── Compact (hero-action) styles ──────────────────── */
  .download-compact-wrap {
    display: inline-flex;
    align-items: center;
    position: relative;
    overflow: visible;
    isolation: isolate;
  }

  .download-compact {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.4375rem 0.75rem;
    background: hsl(0 84% 40%);
    border: 1px solid hsl(0 84% 40%);
    color: hsl(0 0% 100%) !important;
    font-family: "Aldrich", sans-serif;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.1875;
    text-decoration: none !important;
    cursor: pointer;
    transition: background 150ms, border-color 150ms;
    user-select: none;
    white-space: nowrap;
  }

  .download-compact:hover {
    background: hsl(0 80% 50%);
    border-color: hsl(0 80% 50%);
  }

  .dc-icon {
    font-size: 1em;
    line-height: 1;
    flex-shrink: 0;
    margin-right: 0.1em;
  }

  .dc-label {
    font-size: inherit;
  }

  .dc-os-svg {
    display: inline-flex;
    align-items: center;
    line-height: 0;
    margin-left: 0.15em;
  }

  .dc-os-svg svg {
    width: 1.1em;
    height: 1.1em;
    display: block;
  }

  .dc-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.4375rem 0.5rem 0.4375rem 0.25rem;
    background: hsl(0 84% 40%);
    border: 1px solid hsl(0 84% 40%);
    border-left: 1px solid hsla(0, 0%, 0%, 0.15);
    color: hsl(0 0% 100%);
    cursor: pointer;
    transition: background 150ms;
    border-radius: 0;
    align-self: stretch;
  }

  .dc-toggle:hover,
  .dc-toggle.active {
    background: hsl(0 80% 55%);
  }

  .dc-toggle svg {
    transition: transform 200ms;
    display: block;
    width: 0.75em;
    height: 0.75em;
  }

  .dc-toggle.active svg {
    transform: rotate(180deg);
  }

  .compact-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 100;
    margin-top: 4px;
    min-width: 100%;
    width: max-content;
    background: hsl(220 18% 8%);
    border: 1px solid hsl(220 12% 18%);
    box-shadow: 0 8px 24px hsla(0, 0%, 0%, 0.5);
    border-radius: 0.4rem;
  }

  .compact-dropdown.hidden {
    display: none;
  }

  .c-option {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.65rem 1rem;
    background: transparent;
    border: none;
    color: hsl(215 12% 70%);
    font-family: inherit;
    font-size: var(--sl-text-sm);
    cursor: pointer;
    transition: background 150ms, color 150ms;
    text-align: left;
    white-space: nowrap;
  }

  .c-option:hover {
    background: hsl(220 12% 16%);
    color: hsl(210 20% 92%);
  }

  .c-option.selected {
    color: hsl(0 84% 60%);
    background: hsl(0 84% 60% / 0.08);
  }

  .c-option strong {
    font-weight: 400;
    color: inherit;
  }

  .c-option-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    opacity: 0.75;
    line-height: 0;
  }

  .c-option-text {
    flex: 1;
  }

  .c-option-size {
    font-size: 0.68rem;
    opacity: 0.45;
